# ---- Aplicação ----
NODE_ENV=development
PORT=3003
LOG_LEVEL=info
SERVICE_NAME=sales-service

# ---- Banco de dados ----
DATABASE_URL=postgresql://revenda:revenda@localhost:5434/sales?schema=public
# `password` usa a senha da URL (desenvolvimento). Em produção é `iam`: token IAM
# gerado a cada conexão ao RDS Proxy, sem senha na URL.
DB_AUTH_MODE=password

# ---- Mensageria e orquestração ----
EVENT_BUS_NAME=revenda-bus
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# ARN da máquina de estados do Step Functions que orquestra a compra.
# Vazio => modo `inline`: a SAGA roda dentro do próprio serviço (desenvolvimento).
PURCHASE_SAGA_STATE_MACHINE_ARN=
SAGA_MODE=inline

# ---- Serviços parceiros ----
VEHICLE_SERVICE_URL=http://localhost:3001
CUSTOMER_SERVICE_URL=http://localhost:3002
PARTNER_REQUEST_TIMEOUT_MS=5000
PARTNER_MAX_RETRIES=3

# ---- Autenticação ----
COGNITO_USER_POOL_ID=us-east-1_local
COGNITO_CLIENT_ID=local-client-id
COGNITO_ISSUER=http://localhost:9229/local
JWT_DEV_SECRET=dev-only-secret-change-me
AUTH_MODE=dev
# Credenciais máquina-a-máquina usadas para chamar os outros serviços.
M2M_CLIENT_ID=sales-service
M2M_CLIENT_SECRET=dev-only-secret-change-me
M2M_TOKEN_URL=http://localhost:9229/local/oauth2/token

# ---- Pagamento ----
PAYMENT_PROVIDER=fake
PAYMENT_API_URL=http://localhost:9300
PAYMENT_API_KEY=dev-only-key
# Segredo usado para validar a assinatura HMAC do webhook do provedor.
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret

# ---- Regras da SAGA ----
# Prazo para o cliente pagar. Precisa ser MENOR que o TTL da reserva no
# vehicle-service, para que a compensação aconteça antes do veículo voltar
# sozinho à vitrine.
PAYMENT_WINDOW_MINUTES=25
