# ---- Aplicação ----
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
SERVICE_NAME=vehicle-service

# ---- Banco de dados (Aurora Serverless v2 PostgreSQL via RDS Proxy em produção) ----
DATABASE_URL=postgresql://revenda:revenda@localhost:5432/vehicles?schema=public
# `password` usa a senha da URL (desenvolvimento). Em produção é `iam`: token IAM
# gerado a cada conexão ao RDS Proxy, sem senha na URL.
DB_AUTH_MODE=password

# ---- Mensageria ----
EVENT_BUS_NAME=revenda-bus
AWS_REGION=us-east-1
# Endpoint local (LocalStack). Em produção deixe vazio para usar o endpoint real da AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# ---- Autenticação (Amazon Cognito) ----
COGNITO_USER_POOL_ID=us-east-1_local
COGNITO_CLIENT_ID=local-client-id
COGNITO_ISSUER=http://localhost:9229/local
# Em desenvolvimento aceita tokens HS256 assinados com este segredo (nunca use em produção)
JWT_DEV_SECRET=dev-only-secret-change-me
AUTH_MODE=dev

# ---- Regras de negócio ----
RESERVATION_TTL_MINUTES=30
