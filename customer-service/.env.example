# ---- Aplicação ----
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
SERVICE_NAME=customer-service

# ---- Banco de dados (Aurora Serverless v2 PostgreSQL, criptografado em repouso com KMS) ----
DATABASE_URL=postgresql://revenda:revenda@localhost:5433/customers?schema=public

# ---- Mensageria ----
EVENT_BUS_NAME=revenda-bus
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# ---- Autenticação ----
COGNITO_USER_POOL_ID=us-east-1_local
COGNITO_CLIENT_ID=local-client-id
COGNITO_ISSUER=http://localhost:9229/local
JWT_DEV_SECRET=dev-only-secret-change-me
AUTH_MODE=dev

# ---- Criptografia de dados pessoais ----
# `kms`  : envelope encryption com AWS KMS (produção).
# `local`: chave simétrica local, APENAS para desenvolvimento e testes.
CRYPTO_MODE=local
KMS_KEY_ID=alias/revenda-customer-pii
# Chave de 32 bytes em base64 usada no modo `local`.
LOCAL_MASTER_KEY=bG9jYWwtZGV2LW1hc3Rlci1rZXktMzItYnl0ZXMtISE=
# Pepper do índice cego de CPF. Em produção vem do Secrets Manager, com rotação.
CPF_BLIND_INDEX_PEPPER=dev-only-pepper-change-me
CPF_PEPPER_SECRET_ID=revenda/customer-service/cpf-pepper

# ---- LGPD ----
PRIVACY_POLICY_VERSION=2026-01
# Retenção obrigatória de dados fiscais após a anonimização do titular (anos).
FISCAL_RETENTION_YEARS=5
